# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# IA: la API key de OpenAI NO va aquí (todo lo VITE_* queda público en el bundle).
# Se configura como secreto de la Edge Function `ai-completion`:
#   supabase secrets set OPENAI_API_KEY=sk-...
# Opcional: poner en false para ocultar las funciones de IA en la UI
VITE_AI_ENABLED=true
